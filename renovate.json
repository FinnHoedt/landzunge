{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 3,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "NestJS",
      "matchPackageNames": [
        "/^@nestjs//"
      ]
    },
    {
      "matchPackageNames": ["react", "react-dom", "/^@types/react/"],
      "groupName": "React"
    },
    {
      "groupName": "Tiptap",
      "matchPackageNames": [
        "/^@tiptap//"
      ]
    },
    {
      "groupName": "Fontsource",
      "matchPackageNames": [
        "/^@fontsource//"
      ]
    },
    {
      "matchPackageNames": ["vite", "/^@vitejs//"],
      "groupName": "Vite"
    },
  ]
}

